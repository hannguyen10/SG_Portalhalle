--- !u!114 &963381325
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 963381322}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94927593c3613e5499883db500a086e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 1519976314}
  dialogueLines:
  - text: "Zeit f\xFCr Wissen."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Hier siehst du die sieben freien K\xFCnste."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Auf Latein die Septem Artes Liberales.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Oder einfach gesagt, die Artes.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Im Mittelalter glaubte man, wer sie beherrscht, versteht die Welt.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Zun\xE4chst das Trivium."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die Dreiheit der sprachlichen K\xFCnste."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: 'Bestehend aus Grammatik, Dialektik und Rhetorik.

'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Dann das Quadrivium.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Sie bezieht sich auf die mathematischen Disziplinen.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "N\xE4mlich Arithmetik, Geometrie, Musik und Astronomie.\r\n"
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Jede Kunst tr\xE4gt ihr eigenes Attribut."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Und jedes zeigt, wie sehr Sprache, Zahlen und Musik mit der g\xF6ttlichen
      Ordnung verbunden waren.\r\n"
    image: {fileID: 0}
    portrait: {fileID: 0}
  quizData: {fileID: 11400000, guid: f57877d1f838d144e981d9c37baa3e47, type: 2}
  quizManager: {fileID: 703186750}
  hintUI: {fileID: 2033021684}
  hintText: Klicke, um mehr zu erfahren
