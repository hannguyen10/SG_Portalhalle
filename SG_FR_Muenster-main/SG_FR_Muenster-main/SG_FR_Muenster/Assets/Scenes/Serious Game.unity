--- !u!114 &997868986
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 997868983}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94927593c3613e5499883db500a086e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 365554578}
  dialogueLines:
  - text: "Diese Halle war kein blo\xDFer Durchgang zum Kirchenraum."
    image: {fileID: 0}
  - text: Die Menschen blieben hier stehen, betrachteten die Figuren
    image: {fileID: 0}
  - text: "und dachten \xFCber Glaube, Recht und ihr eigenes Leben nach."
    image: {fileID: 0}
  - text: Man ging hier nicht einfach nur hindurch.
    image: {fileID: 0}
  - text: Dieser Ort sollte zum Nachdenken bringen.
    image: {fileID: 0}
  - text: "Siehst du die Steinb\xE4nke an den W\xE4nden?"
    image: {fileID: 0}
  - text: "Sie geben Hinweise darauf, dass die Halle m\xF6glicherweise als Gerichtssaal
      geplant war."
    image: {fileID: 0}
  - text: "Die Sitzposition der Grafen spricht zumindest daf\xFCr.\r\n"
    image: {fileID: 0}
  - text: "Die findest du seitlich au\xDFerhalb der Halle.\r\n"
    image: {fileID: 0}
  - text: 'Beweise gibt es keine.

'
    image: {fileID: 0}
  - text: Aber einiges deutet darauf hin.
    image: {fileID: 0}
  - text: "Die Halle erinnert an Kapitels\xE4le mittelalterlicher Kl\xF6ster.\r\n"
    image: {fileID: 0}
  - text: "Ein Ort f\xFCr Gemeinschaft, Versammlung, aber auch f\xFCr Kontrolle.\r\n"
    image: {fileID: 0}
  - text: "Und die Figuren an den W\xE4nden?"
    image: {fileID: 0}
  - text: Eine Bilderbibel aus Stein.
    image: {fileID: 0}
  - text: "Viele Menschen konnten nicht lesen und besa\xDFen kaum B\xFCcher."
    image: {fileID: 0}
  - text: Hier wurden Ihnen die Grundlagen des christlichen Glaubens dargestellt.
    image: {fileID: 0}
  - text: 'Von der Geburt Christ bis zu seiner Wiederkehr. '
    image: {fileID: 0}
  quizData: {fileID: 11400000, guid: 34d81dd3ee881f64fabc470088860e92, type: 2}
  quizManager: {fileID: 1710379045}
  hintUI: {fileID: 653437158}
  hintText: Klicke, um mehr zu erfahren
