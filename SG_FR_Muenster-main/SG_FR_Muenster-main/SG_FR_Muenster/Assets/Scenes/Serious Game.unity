--- !u!114 &2058363386
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2058363384}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94927593c3613e5499883db500a086e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 1519976314}
  dialogueLines:
  - text: Falls du es noch nicht gemerkt hast.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Diese Halle ist alt.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Sehr alt.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: 'Wann genau sie gebaut wurde?

'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Tja\u2026 dar\xFCber streiten sich die Gelehrten."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Schriftliche Quellen zur Baugeschichte gibt es kaum.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Ich selbst kam erst sp\xE4ter dazu."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Aber laut der Forschung begann der Bau um 1270.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Und wichtig zu erw\xE4hnen."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die Halle kam nicht zuerst und die Figuren sp\xE4ter."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Alles wurde gemeinsam konzipiert.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Die Figuren im Tympanon.
    image: {fileID: 21300000, guid: b43ce4bcac7269d4796a232c084ac17e, type: 3}
    portrait: {fileID: 0}
  - text: Die Archivoltenfiguren.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die gro\xDFen Skulpturen an den W\xE4nden."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Keine nachtr\xE4gliche Dekoration.\r\n"
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Alles Teil eines durchdaten Konzepts.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die gro\xDFen freistehenden Figuren, zum Beispiel die Jungfrauen, wurden
      erst ganz zum Schluss aufgestellt."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Doch ihre Sockel waren breiter als gedacht.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Einige der unteren Giebelkrabben mussten deshalb abgeschlagen werden.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Stein kann man bearbeiten.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Aber Platz hat er auch nicht unendlich.
    image: {fileID: 0}
    portrait: {fileID: 0}
  quizData: {fileID: 11400000, guid: 2debf5865b0f7354ea3aced6478f7bbc, type: 2}
  quizManager: {fileID: 703186750}
  hintUI: {fileID: 2033021684}
  hintText: Klicke, um mehr zu erfahren
