--- !u!114 &171260241
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 171260236}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94927593c3613e5499883db500a086e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 1519976314}
  dialogueLines:
  - text: "Kommen wir zu etwas\u2026 Verf\xFChrerischem."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Den \u201CF\xFCrsten der Welt\u201D, Voluptas und einen Engel."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Schauen wir uns den F\xFCrsten n\xE4her an."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Von vorne?
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Sch\xF6n."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Charmant.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Fast \xFCberzeugend."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Doch wirf einen Blick auf die R\xFCckseite."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Kr\xF6ten."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Schlangen.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Molche.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "\xDCberraschend?"
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Nicht wirklich.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Die Botschaft ist klar.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Nicht alles, was gl\xE4nzt, ist Gold."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: 'Der Engel daneben warnt schon davor.

'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: '"Fallt nicht in Versuchung."'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: '"Wachet und betet."'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: '"Geht nicht hinaus."'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Eine sch\xF6ne Welt kann tr\xFCgerisch sein."
    image: {fileID: 0}
    portrait: {fileID: 0}
  quizData: {fileID: 11400000, guid: e31679d68145e084196b20f9de041538, type: 2}
  quizManager: {fileID: 703186750}
  hintUI: {fileID: 2033021684}
  hintText: Klicke, um mehr zu erfahren
