--- !u!114 &934025375
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 934025373}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 94927593c3613e5499883db500a086e7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueManager: {fileID: 1519976314}
  dialogueLines:
  - text: "Ah\u2026 meine Lieblingsgeschichte."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Zehn Jungfrauen warten hier.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "F\xFCnf klug."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "F\xFCnf t\xF6richt."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Damals lief eine Hochzeit anders ab als heute.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Die Braut wartete im Haus ihrer Eltern.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Sp\xE4t am Abend kam der Br\xE4utigam mit Musik und einem Festzug, um
      sie in sein eigenes Haus zu f\xFChren."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Die Jungfrauen warteten mit ihren Lampen, um den Hochzeitszug zu begleiten.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Doch nachts braucht man Licht.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Lampen und \xD6l.\r\n"
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Alle zehn Jungfrauen warten lange.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Sie werden m\xFCde und schlafen ein."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Das kann passieren.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: 'Dann um Mitternacht der Ruf.

'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "\u201CDer Br\xE4utigam kommt!\u201D"
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Jetzt entscheidet sich alles.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die Klugen haben zus\xE4tzliches \xD6l mitgebracht."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Sie sind vorbereitet.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Ihre Lampen brennen weiter.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die T\xF6richten hingegen?"
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Kein zus\xE4tzliches \xD6l."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Ihre Lampen gehen aus.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: 'Und genau das siehst du an den Steinfiguren wieder.

'
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Die klugen Jungfrauen halten ihre Lampen nach oben.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die t\xF6richten Jungfrauen halten ihre Lampen nach unten. "
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "W\xE4hrend sie neues \xD6l suchen, zieht der Hochzeitszug weiter. "
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die T\xFCr wird verschlossen."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Sie sind zu sp\xE4t und kommen nicht mehr rein."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Kleine Lampen.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Gro\xDFe Konsequenzen."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Der Br\xE4utigam steht f\xFCr Christus."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die Brautjungfern stehen f\xFCr die Gl\xE4ubigen."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Die Lampen f\xFCr den Glauben."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Die Wartezeit erinnert an die Zeit, in der Menschen auf seine Wiederkunft
      warten.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Die Botschaft ist einfach.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Wer wachsam ist und den Glauben beh\xE4lt, darf eintreten."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Wer nicht wachsam ist, bleibt drau\xDFen."
    image: {fileID: 0}
    portrait: {fileID: 0}
  quizData: {fileID: 11400000, guid: 72473ec677b24ac40a942ab38d3d85ac, type: 2}
  quizManager: {fileID: 703186750}
  hintUI: {fileID: 2033021684}
  hintText: Klicke, um mehr zu erfahren
