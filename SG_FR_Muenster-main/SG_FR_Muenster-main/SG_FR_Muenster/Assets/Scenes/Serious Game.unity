--- !u!114 &1416928187
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1416928186}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aa3ec47193a2b9740bd0d322a7413e0f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSystem: {fileID: 1519976314}
  endDialogue:
  - text: Die meisten Menschen laufen gedankenlos hindurch.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Du nicht.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Du hast heute innegehalten, tiefer hineingeblickt und die Geschichte dahinter
      erkannt.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Das h\xE4tte den Erbauern gefallen."
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: "Mir \xFCbrigens auch."
    image: {fileID: 0}
    portrait: {fileID: 21300000, guid: 8cd97e44cc7e7c1419d4f0dbf06684e8, type: 3}
  - text: 'Vielleicht sehen wir uns wieder.

'
    image: {fileID: 0}
    portrait: {fileID: 21300000, guid: 37fd9c28f56c58c48b287f219087079c, type: 3}
  - text: Ich werde hier sein.
    image: {fileID: 0}
    portrait: {fileID: 0}
  - text: Aus Stein und mit offenen Augen.
    image: {fileID: 0}
